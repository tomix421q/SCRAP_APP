generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  cardId        Int            @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String         @default("USER")
  accounts      Account[]
  userLogs      ActivityLogs[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}




model ScrapSummary {
  id          Int       @id @default(autoincrement())
  material      Int
  scrapCodeId Int
  date        DateTime
  totalQty    Int
  scrapCode   ScrapCode @relation(fields: [scrapCodeId], references: [id], onDelete: Cascade)

  @@unique([material, scrapCodeId, date])
  @@index([date])
}

model Operator {
  id           Int            @id @default(autoincrement())
  createdBy    String
  fullName     String
  cardId       Int            @unique
  createdAt    DateTime       @default(now())
  operatorLogs ActivityLogs[]
}

model ActivityLogs {
  id         Int       @id @default(autoincrement())
  userId     String?
  operatorId Int?
  action     String
  entityType String
  entityId   Int?
  timestamp  DateTime  @default(now())
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model ScrapCode {
  id           Int            @id @default(autoincrement())
  vProject     String? @db.VarChar(20)
  code         String
  name         String
  description  String?
  active       Boolean        @default(true)
  scrapRecords ScrapRecord[]
  scrapSummary ScrapSummary[]
  groups       PartGroup[]    @relation("PartGroupToScrapCode")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([vProject,code])
}
model PartGroup {
  id            Int           @id @default(autoincrement())
  name          String        @db.NVarChar(64)
  vProject      String? @db.VarChar(20)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isRebuild     Boolean       @default(false)
  interfaceName String
  qadIdentity   String?
  scrapRecords  ScrapRecord[]
  labelGroups   LabelGroup[]  @relation("LabelGroupToPartGroup")
  scrapCodes    ScrapCode[]   @relation("PartGroupToScrapCode")
  materials     PartGroupMaterial[]

  @@unique([name, vProject])
  @@index([vProject])
  @@index([name])
}

model PartGroupMaterial {
  id    Int @id @default(autoincrement())
  partGroupId   Int
  material    String @db.NVarChar(50)
  side        String? @db.VarChar(20)
  description String? @db.VarChar(60)
  partGroup PartGroup @relation(fields: [partGroupId],references: [id],onDelete: Cascade)

  @@unique([partGroupId,material])
  @@index([material])
}

model LabelGroup {
  id        Int         @id @default(autoincrement())
  code      String      @db.NVarChar(64)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  vProject  String? @db.VarChar(20)
  groups    PartGroup[] @relation("LabelGroupToPartGroup")

  @@unique([code, vProject])
  @@index([vProject])
}


model ScrapRecord {
  id                Int        @id @default(autoincrement())
  dmc               String     @db.NVarChar(128)
  partGroupId       Int
  scrapCodeId       Int?
  isRebuild         Boolean    @default(false)
  replacementPartMaterial String? @db.NVarChar(50)
  isOtherComponent  Boolean    @default(false)
  quantity          Float      @default(1)
  description       String?
  createdBy         String
  createdAt         DateTime   @default(now())
  QADExported       Boolean?   @default(false)
  partGroup         PartGroup  @relation(fields: [partGroupId], references: [id], onUpdate: NoAction,onDelete: Cascade)
  scrapCode         ScrapCode? @relation(fields: [scrapCodeId], references: [id], onDelete: Cascade)

  @@index([dmc])
  @@index([createdAt])
  @@index([partGroupId])
  @@index([scrapCodeId])
}

view vParts {
  Material    String @unique @db.NVarChar(50)
  Description String? @db.VarChar(60)
  P_L         String? @db.VarChar(10)
  PartGroup   String? @db.NVarChar(50)
  Side        String? @db.VarChar(20)
  Customer    String? @db.NVarChar(50)
  Hall        String? @db.VarChar(20)
  Project     String? @db.VarChar(20)
}

